# docs/ holds working notes, with one exception. The experiment record is the
# answer to "why not one store", so it ships. The rule is docs/* and not docs/,
# because git cannot re-include a file inside a directory it already excluded.
docs/*
!docs/decisions.md
!docs/design-experiments.md
!docs/development-plan.md
!docs/test-plan.md

