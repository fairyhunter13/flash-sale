{
  "name": "flash-sale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web",
    "stress"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run db:up && concurrently -n server,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "start": "npm run db:up && npm run build && npm start -w server",
    "test": "vitest run",
    "test:unit": "vitest run --project '*-unit'",
    "test:integration": "vitest run --project '*-integration'",
    "test:watch": "vitest",
    "stress": "npm run stress -w stress",
    "bench": "npm run bench -w stress",
    "db:up": "docker compose up -d --wait",
    "sale:window": "node --env-file=.env.example --env-file-if-exists=.env --experimental-strip-types server/src/tools/set-window.ts",
    "db:down": "docker compose down -v",
    "reset": "npm run db:down && npm start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
