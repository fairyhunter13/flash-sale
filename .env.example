# The server reads this file, so a fresh clone needs no copy. Every value here
# is an address or a size. A missing one stops the process at boot.
#
# To change a value, write it into a .env beside this file. The server reads
# .env second, so it wins. Docker Compose reads .env and never this file, so a
# port change belongs in .env or it reaches the server alone.
#
# The sale itself is not here. The unit count and the window are a row, written
# by server/sql/migrations/0002_campaign.sql. Change the campaign there.

# The database. POSTGRES_PORT is the port on your box, and docker-compose.yml
# reads it. Change it together with DATABASE_URL where another Postgres already
# holds the default port.
POSTGRES_PORT=5432
DATABASE_URL=postgres://flash:flash@localhost:5432/flash

# The most connections this process ever opens to Postgres. It is the cap that
# keeps a traffic spike out of the database: 1,000,000 open browsers still send
# at most this many statements at once.
DB_POOL_MAX=20

# The server
PORT=3000
HOST=0.0.0.0

# The hot state. Redis answers every buyer, so it holds the count and the
# winner set. REDIS_PORT is the port on your box, and docker-compose.yml reads
# it. Change it together with REDIS_URL where another Redis already holds the
# default port.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# The queue. Kafka carries each win from Redis to the workers that write
# Postgres. KAFKA_BROKERS is a comma-separated list.
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092

# How many consumers this process runs. Kafka splits the topic into a fixed
# number of partitions and gives each consumer whole ones, so a number above
# the partition count leaves consumers idle.
QUEUE_WORKERS=4
