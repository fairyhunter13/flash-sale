# Copy this file to .env. The server reads every number from here, so no number
# is a constant in the source. A missing one stops the process at boot.

# The sale
SALE_STOCK=1000
SALE_START=2026-01-01T00:00:00Z
SALE_END=2036-01-01T00:00:00Z

# The database. POSTGRES_PORT is the port on your box, and docker-compose.yml
# reads it. Change it together with DATABASE_URL where another Postgres already
# holds the default port.
POSTGRES_PORT=5432
DATABASE_URL=postgres://flash:flash@localhost:5432/flash

# The most connections this process ever opens to Postgres. It is the cap that
# keeps a traffic spike out of the database: 1,000,000 open browsers still send
# at most this many statements at once.
DB_POOL_MAX=20

# The server
PORT=3000
HOST=0.0.0.0

# The hot state. Redis answers every buyer, so it holds the count and the
# winner set. REDIS_PORT is the port on your box, and docker-compose.yml reads
# it. Change it together with REDIS_URL where another Redis already holds the
# default port.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# The queue. Kafka carries each win from Redis to the workers that write
# Postgres. KAFKA_BROKERS is a comma-separated list.
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092

# How many consumers this process runs. Each one owns whole partitions, so a
# number above the partition count leaves consumers idle.
QUEUE_WORKERS=4
