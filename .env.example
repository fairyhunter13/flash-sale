# Copy this file to .env. The server reads every number from here, so no number
# is a constant in the source. A missing one stops the process at boot.

# The sale
SALE_STOCK=1000
SALE_START=2026-01-01T00:00:00Z
SALE_END=2036-01-01T00:00:00Z

# The engines. REDIS_PORT and POSTGRES_PORT are the ports on your box, and
# docker-compose.yml reads them. Change both numbers together with the two URLs
# where another Redis or another Postgres already holds the default port.
REDIS_PORT=6379
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://flash:flash@localhost:5432/flash

# The server
PORT=3000
HOST=0.0.0.0
